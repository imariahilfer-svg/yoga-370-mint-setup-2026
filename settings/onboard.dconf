[/]
layout='@HOME@/.local/share/onboard/layouts/Austrian.onboard'
schema-version='2.3'
show-status-icon=true
start-minimized=true
system-theme-associations={'HighContrast': 'HighContrast', 'HighContrastInverse': 'HighContrastInverse', 'LowContrast': 'LowContrast', 'ContrastHighInverse': 'HighContrastInverse', 'Default': ''}
use-system-defaults=false

[auto-show]
enabled=true
tablet-mode-detection-enabled=true
tablet-mode-state-file='/sys/devices/platform/thinkpad_acpi/hotkey_tablet_mode'
tablet-mode-state-file-pattern='1'

[keyboard]
touch-feedback-enabled=true
touch-input='multi'

[theme-settings]
color-scheme='/usr/share/onboard/themes/Charcoal.colors'
key-fill-gradient=8.0
key-gradient-direction=-3.0
key-label-overrides=['RWIN:Super:', 'LWIN:Super:']
key-size=94.0
key-stroke-gradient=8.0
key-stroke-width=0.0
key-style='gradient'
roundrect-radius=20.0

[window]
docking-edge='bottom'
docking-enabled=true
force-to-top=true

[window/landscape]
dock-expand=true
dock-height=330

[window/portrait]
dock-expand=true
dock-height=420
